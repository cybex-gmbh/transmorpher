APP_NAME=Transmorpher
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://transmorpher.test
APP_SERVICE=app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

############################################################### Transmorpher

# General settings
TRANSMORPHER_DEV_MODE=false
TRANSMORPHER_STORE_DERIVATIVES=true
#TRANSMORPHER_SIGNING_KEYPAIR=
#CACHE_INVALIDATION_COUNTER_FILE_PATH="cacheInvalidationCounter"
TRANSMORPHER_UPLOAD_HANDLER=default

# Disks
TRANSMORPHER_DISK_ORIGINALS=localOriginals
TRANSMORPHER_DISK_IMAGE_DERIVATIVES=localImageDerivatives
TRANSMORPHER_DISK_DOCUMENT_DERIVATIVES=localDocumentDerivatives
TRANSMORPHER_DISK_VIDEO_DERIVATIVES=localVideoDerivatives

# Optimizer
TRANSMORPHER_OPTIMIZER_TIMEOUT=10

# Transcoding
# More information: https://github.com/cybex-gmbh/transmorpher/tree/release/v0#configuration-options
VIDEO_TRANSCODING_WORKERS_AMOUNT=1
#TRANSMORPHER_VIDEO_ENCODER=cpu-hevc
#TRANSMORPHER_VIDEO_ENCODER_BITRATE=9000k

# Documents
#TRANSMORPHER_DOCUMENT_REMOVE_METADATA=true
#TRANSMORPHER_DOCUMENT_DEFAULT_PPI=600

# Queues
# Queue names: append .fifo to use SQS FIFO (e.g., video-transcoding.fifo)
# Connections: leave blank to inherit QUEUE_CONNECTION, or override per queue
TRANSMORPHER_VIDEO_TRANSCODING_QUEUE=video-transcoding
#TRANSMORPHER_VIDEO_TRANSCODING_QUEUE_CONNECTION=
TRANSMORPHER_CLIENT_NOTIFICATIONS_QUEUE=client-notifications
#TRANSMORPHER_CLIENT_NOTIFICATIONS_QUEUE_CONNECTION=
TRANSMORPHER_EMAIL_QUEUE=email
#TRANSMORPHER_EMAIL_QUEUE_CONNECTION=

###############################################################

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_USE_PATH_STYLE_ENDPOINT=false
# AWS S3
AWS_BUCKET_ORIGINALS=
AWS_BUCKET_IMAGE_DERIVATIVES=
AWS_BUCKET_DOCUMENT_DERIVATIVES=
AWS_BUCKET_VIDEO_DERIVATIVES=
# AWS CloudFront
AWS_CLOUDFRONT_DISTRIBUTION_ID=
# AWS SQS
# E.g. https://sqs.eu-central-1.amazonaws.com/<account-id>, can be found in the AWS SQS console
SQS_PREFIX=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_FOLDER=transmorpher

DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=transmorpher
DB_USERNAME=transmorpher
DB_PASSWORD=transmorpher

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
